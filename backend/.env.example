# Plantilla de variables de entorno para desarrollo.
# Copia este archivo a `.env` y ajusta los valores. NUNCA commitees `.env`.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://confiabilidad:confiabilidad@localhost:5432/confiabilidad
REDIS_URL=redis://localhost:6379/0
# Caché de datos en un índice Redis aislado; por defecto se deriva de REDIS_URL con /1
CACHE_URL=redis://localhost:6379/1
# Sesiones en un índice Redis aislado de la caché de datos; por defecto /2
SESSION_CACHE_URL=redis://localhost:6379/2
# Orígenes CORS del cliente de escritorio Tauri (multiplataforma); separados por coma
CORS_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost,http://localhost:1420
# Registro pendiente y cambio de contraseña: los dos procesos comparten estos límites y el
# secreto de los códigos. Comentadas = valores por defecto; descomenta solo lo que cambies.
# No dejes una variable vacía: una línea vacía no usa el valor por defecto.
# REGISTRATION_MAX_FAILED_ATTEMPTS=5
# REGISTRATION_CODE_TTL_MINUTES=15
# REGISTRATION_GRACE_MINUTES=15
# REGISTRATION_MAX_LIFETIME_MINUTES=60
# REGISTRATION_SECRET_TRANSITION_MINUTES=60
# PWNED_PASSWORDS_TIMEOUT_SECONDS=2.0
# PWNED_PASSWORDS_ENABLED=true
# Secreto de las huellas de los códigos; sin definir usa DJANGO_SECRET_KEY.
# REGISTRATION_CODE_SECRET=
# Rotación: secreto anterior y fecha ISO 8601 con zona horaria del cambio.
# REGISTRATION_CODE_SECRET_PREVIOUS=
# REGISTRATION_CODE_SECRET_ROTATED_AT=2026-10-06T10:00:00+00:00
# Consentimientos: secreto de la huella del correo; sin definir usa DJANGO_SECRET_KEY.
# En producción, propio y que no rote nunca (ver HUMAN_TODO.md).
# CONSENT_EMAIL_HASH_SECRET=
# Correos: clave de la máscara del código de los correos pendientes. Sin definir vale
# email-code: seguido de DJANGO_SECRET_KEY. Distinta de REGISTRATION_CODE_SECRET y sin rotación.
# EMAIL_CODE_SECRET=
# Correos (correo-asincrono-plantillas). Sin EMAIL_BACKEND, los correos salen por la consola del
# worker. En producción, el SMTP de MXroute; usuario y contraseña van cifrados con SOPS.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=<SERVIDOR_MXROUTE>
# EMAIL_PORT=465
# EMAIL_HOST_USER=no-responder@notificaciones.<TU_DOMINIO>
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_SSL=true
# EMAIL_USE_TLS=false
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=no-responder@notificaciones.<TU_DOMINIO>
# Dirección a la que el titular reporta un aviso que no reconoce.
# EMAIL_SUPPORT_ADDRESS=soporte@localhost
# Dirección del frontend a la que llevan los enlaces de los correos.
# FRONTEND_BASE_URL=http://localhost:5173
# Horas de reintento de los avisos de seguridad y minutos del tope del aviso "ya tienes cuenta".
# EMAIL_NOTICE_RETRY_HOURS=24
# EMAIL_ACCOUNT_EXISTS_WINDOW_MINUTES=60
