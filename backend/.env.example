# Plantilla de variables de entorno para desarrollo.
# Copia este archivo a `.env` y ajusta los valores. NUNCA commitees `.env`.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://confiabilidad:confiabilidad@localhost:5432/confiabilidad
REDIS_URL=redis://localhost:6379/0
# Caché de datos en un índice Redis aislado; por defecto se deriva de REDIS_URL con /1
CACHE_URL=redis://localhost:6379/1
# Sesiones en un índice Redis aislado de la caché de datos; por defecto /2
SESSION_CACHE_URL=redis://localhost:6379/2
# Orígenes CORS del cliente de escritorio Tauri (multiplataforma); separados por coma
CORS_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost,http://localhost:1420
# Registro pendiente. Comentadas = valores por defecto; descomenta solo lo que cambies.
# No dejes una variable vacía: una línea vacía no usa el valor por defecto.
# REGISTRATION_MAX_FAILED_ATTEMPTS=5
# REGISTRATION_CODE_TTL_MINUTES=15
# REGISTRATION_GRACE_MINUTES=15
# REGISTRATION_MAX_LIFETIME_MINUTES=60
# REGISTRATION_SECRET_TRANSITION_MINUTES=60
# PWNED_PASSWORDS_TIMEOUT_SECONDS=2.0
# Secreto de las huellas de los códigos; sin definir usa DJANGO_SECRET_KEY.
# REGISTRATION_CODE_SECRET=
# Rotación: secreto anterior y fecha ISO 8601 con zona horaria del cambio.
# REGISTRATION_CODE_SECRET_PREVIOUS=
# REGISTRATION_CODE_SECRET_ROTATED_AT=2026-10-06T10:00:00+00:00
