# Plantilla de variables de entorno para desarrollo.
# Copia este archivo a `.env` y ajusta los valores. NUNCA commitees `.env`.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://confiabilidad:confiabilidad@localhost:5432/confiabilidad
REDIS_URL=redis://localhost:6379/0
# Caché de datos en un índice Redis aislado; por defecto se deriva de REDIS_URL con /1
CACHE_URL=redis://localhost:6379/1
# Sesiones en un índice Redis aislado de la caché de datos; por defecto /2
SESSION_CACHE_URL=redis://localhost:6379/2
